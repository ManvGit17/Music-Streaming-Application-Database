# Copy to .env and change for anything other than local development.

POSTGRES_PASSWORD=vamusic-dev
VAMUSIC_APP_PASSWORD=vamusic-app-dev
# At least 32 bytes. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
VAMUSIC_JWT_SECRET=local-development-only-secret-change-me

# tiny (~6k plays), demo (~60k plays, the default) or full (~1M plays, takes about a minute)
VAMUSIC_SCALE=demo

API_PORT=8000
POSTGRES_PORT=5432
